    <!-- JAVASCRIPT GAME LOGIC (OOP & CLEAN ARCHITECTURE) -->
    <script>
        /**
         * 1. QUESTION & ARTIFACT DATABASE (ข้อมูลอักษรและศิลาจารึกลายสือไทย 5 ด่าน)
         */
        const QUESTIONS_DB = [
            {
                level: 1,
                title: "ROOM 1: ปฐมลายสือไทย",
                ancientChar: "ก",
