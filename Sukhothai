                ancientSvg: `<svg viewBox="0 0 100 100" class="w-16 h-16 stroke-current fill-none stroke-[6]"><path d="M 40 30 Q 30 20 45 20 Q 60 20 55 35 L 45 75 L 65 75" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
