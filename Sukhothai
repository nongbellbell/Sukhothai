                this.wrongAnswerModal = document.getElementById('wrongAnswerModal');
                this.journalModal = document.getElementById('journalModal');
                this.victoryModal = document.getElementById('victoryModal');
                this.journalGrid = document.getElementById('journalGrid');
                this.journalCountBadge = document.getElementById('journalCountBadge');
                
