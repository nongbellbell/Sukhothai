                this.audio = new SoundEngine();

                // Game States: START, WAITING_PANEL, PANEL_OPENING, WAITING_CHOICE, DOOR_UNLOCK, LEVEL_COMPLETE, GAME_OVER
                this.state = 'START';

                // Gameplay Metrics
                this.currentLevelIdx = 0;
                this.score = 0;
                this.wisdomPower = 0; // Max 5
                this.comboCount = 0;
                this.correctAnswers = 0;
                this.totalAttempts = 0;
                this.archaeologistJournal = []; // Unlocked Characters

                // Hand & Cursor State
                this.handLandmarks = null;
                this.cursor = { x: -100, y: -100, targetX: -100, targetY: -100, isPinching: false, pinchCooldown: false };
                this.isHandDetected = false;
                this.isFallbackMode = false;

                // Interactive Elements
                this.panels = [];
                this.choices = [];
                this.selectedPanelIndex = -1;
                this.selectedQuestion = null;

                // Animation States
                this.panelOpenStep = 0; // 0=Closed, 0.5=Glowing/Cracking, 1=Fully Opened
                this.lightRunProgress = 0;
                this.shakingChoice = null;

                // Visual FX
                this.particles = [];
                this.doorOpenProgress = 0;
                this.doorTargetProgress = 0;

                // Init Hand Tracker
                this.tracker = new HandTracker(this.video, (results) => this.onHandResults(results));

                this.bindEvents();
                this.resizeCanvas();
                window.addEventListener('resize', () => this.resizeCanvas());

                // Start Visual Animation Loop
                requestAnimationFrame(() => this.gameLoop());
            }

            resizeCanvas() {
                this.canvas.width = window.innerWidth;
                this.canvas.height = window.innerHeight;
                this.initDustParticles();
            }

            initDustParticles() {
                this.particles = [];
                const count = Math.floor((this.canvas.width * this.canvas.height) / 25000);
                for (let i = 0; i < count; i++) {
                    this.particles.push({
                        x: Math.random() * this.canvas.width,
                        y: Math.random() * this.canvas.height,
                        radius: Math.random() * 2 + 1,
                        speedX: (Math.random() - 0.5) * 0.4,
                        speedY: -Math.random() * 0.5 - 0.2,
                        opacity: Math.random() * 0.5 + 0.2
                    });
                }
            }

            bindEvents() {
                // UI Buttons
                document.getElementById('btnStartGame').addEventListener('click', () => {
                    this.audio.init();
                    this.audio.playClick();
                    this.requestCameraAndStart();
                });

                document.getElementById('btnTutorial').addEventListener('click', () => {
                    this.audio.init();
                    this.audio.playClick();
                    this.showModal('tutorial');
                });

                document.getElementById('btnBackToStart').addEventListener('click', () => {
                    this.audio.playClick();
                    this.requestCameraAndStart();
                });

                document.getElementById('btnRetryCam').addEventListener('click', () => {
                    this.audio.playClick();
                    this.requestCameraAndStart();
                });

                document.getElementById('btnFallbackPlay').addEventListener('click', () => {
                    this.audio.playClick();
                    this.isFallbackMode = true;
                    this.startActualGame();
                });

                document.getElementById('btnNextLevel').addEventListener('click', () => {
                    this.audio.playClick();
                    this.nextLevel();
                });

                document.getElementById('btnPlayAgain').addEventListener('click', () => {
                    this.audio.playClick();
                    this.resetGame();
                });

                // Wrong Answer Modal Action Buttons
                document.getElementById('btnWrongUseHint').addEventListener('click', () => {
                    this.audio.playClick();
                    this.hideModals();
                    this.missionText.innerText = `💡 คำใบ้: ${this.selectedQuestion.hint}`;
                    this.state = 'WAITING_CHOICE';
                });

                document.getElementById('btnWrongTryAgain').addEventListener('click', () => {
                    this.audio.playClick();
                    this.hideModals();
                    this.missionText.innerText = "จงสังเกตรูปร่างอักษร แล้วเลือกคำตอบใหม่อีกครั้ง!";
                    this.state = 'WAITING_CHOICE';
                });

                // Journal Modal Actions
                document.getElementById('btnOpenJournal').addEventListener('click', () => {
                    this.audio.playClick();
                    this.renderJournalUI();
                    this.showModal('journal');
                });

                document.getElementById('btnCloseJournal').addEventListener('click', () => {
                    this.audio.playClick();
                    this.hideModals();
                });

                document.getElementById('toggleHandBtn').addEventListener('click', () => {
                    this.audio.playClick();
                    this.tracker.showVisuals = !this.tracker.showVisuals;
                });

                document.getElementById('toggleAudioBtn').addEventListener('click', (e) => {
                    const isMuted = !this.audio.toggle();
                    e.currentTarget.innerText = isMuted ? '🔇' : '🔊';
                });

                // Mouse/Touch Fallback Events
                window.addEventListener('mousemove', (e) => {
                    if (this.isFallbackMode || !this.isHandDetected) {
                        this.cursor.targetX = e.clientX;
                        this.cursor.targetY = e.clientY;
                    }
                });

                window.addEventListener('mousedown', (e) => {
                    if (this.isFallbackMode || !this.isHandDetected) {
                        this.triggerClick(e.clientX, e.clientY);
                    }
                });

                window.addEventListener('touchstart', (e) => {
                    if (e.touches.length > 0) {
                        const t = e.touches[0];
                        this.cursor.targetX = t.clientX;
                        this.cursor.targetY = t.clientY;
                        this.triggerClick(t.clientX, t.clientY);
                    }
                });
            }

            async requestCameraAndStart() {
                this.modalLayer.classList.remove('hidden');
                this.camStatusText.innerText = "CAMERA: CONNECTING";
                this.camStatusDot.className = "w-2.5 h-2.5 rounded-full bg-yellow-400 animate-ping";

                try {
                    await this.tracker.init();
                    this.camStatusText.innerText = "CAMERA: ACTIVE";
                    this.camStatusDot.className = "w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]";
                    this.startActualGame();
                } catch (err) {
                    console.warn("Camera access failed, fallback enabled:", err);
                    this.camStatusText.innerText = "CAMERA: DISABLED";
                    this.camStatusDot.className = "w-2.5 h-2.5 rounded-full bg-red-500";
                    this.showModal('error');
                }
            }

            startActualGame() {
                this.hideModals();
                this.hudTop.classList.remove('opacity-0');
                this.hudBottom.classList.remove('opacity-0');
                this.loadLevel(0);
            }

            showModal(type) {
                this.modalLayer.classList.remove('hidden');
                this.startScreen.classList.add('hidden');
                this.tutorialScreen.classList.add('hidden');
                this.errorModal.classList.add('hidden');
                this.knowledgeModal.classList.add('hidden');
                this.wrongAnswerModal.classList.add('hidden');
                this.journalModal.classList.add('hidden');
                this.victoryModal.classList.add('hidden');

                if (type === 'start') this.startScreen.classList.remove('hidden');
                if (type === 'tutorial') this.tutorialScreen.classList.remove('hidden');
                if (type === 'error') this.errorModal.classList.remove('hidden');
                if (type === 'knowledge') this.knowledgeModal.classList.remove('hidden');
                if (type === 'wrong') this.wrongAnswerModal.classList.remove('hidden');
                if (type === 'journal') this.journalModal.classList.remove('hidden');
                if (type === 'victory') this.victoryModal.classList.remove('hidden');
            }

            hideModals() {
                this.modalLayer.classList.add('hidden');
            }

            onHandResults(results) {
                if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
                    this.isHandDetected = true;
                    this.handLandmarks = results.multiHandLandmarks[0];

                    this.handStatusDot.className = "w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]";
                    this.handStatusText.innerText = "HAND: DETECTED";

                    const indexTip = this.handLandmarks[8];
                    const thumbTip = this.handLandmarks[4];
                    const middleTip = this.handLandmarks[12];

                    this.cursor.targetX = (1 - indexTip.x) * this.canvas.width;
                    this.cursor.targetY = indexTip.y * this.canvas.height;

                    const dx = thumbTip.x - indexTip.x;
                    const dy = thumbTip.y - indexTip.y;
                    const pinchDist = Math.sqrt(dx * dx + dy * dy);

                    if (pinchDist < 0.055) {
                        if (!this.cursor.isPinching && !this.cursor.pinchCooldown) {
                            this.cursor.isPinching = true;
                            this.cursor.pinchCooldown = true;
                            this.triggerClick(this.cursor.targetX, this.cursor.targetY);
                        }
                    } else if (pinchDist > 0.08) {
                        this.cursor.isPinching = false;
                        this.cursor.pinchCooldown = false;
                    }

                    // Two Finger Gesture (Hint)
                    const dIndexMiddle = Math.hypot(middleTip.x - indexTip.x, middleTip.y - indexTip.y);
                    if (dIndexMiddle < 0.04 && this.state === 'WAITING_CHOICE') {
                        this.missionText.innerText = `💡 คำใบ้: ${this.selectedQuestion.hint}`;
                    }

                } else {
                    this.isHandDetected = false;
                    this.handLandmarks = null;
                    this.handStatusDot.className = "w-2.5 h-2.5 rounded-full bg-amber-400 shadow-[0_0_8px_#fbbf24]";
                    this.handStatusText.innerText = "HAND: SEARCHING...";
                }
            }

            loadLevel(index) {
                this.currentLevelIdx = index;
                this.selectedQuestion = QUESTIONS_DB[index];
                this.doorOpenProgress = 0;
                this.doorTargetProgress = 0;
                this.selectedPanelIndex = -1;
                this.panelOpenStep = 0;
                this.lightRunProgress = 0;
                this.choices = [];
                
                this.roomTitle.innerText = this.selectedQuestion.title;
                this.missionText.innerText = `ด่านที่ ${index + 1}/5: แตะเลือกศิลาจารึก 1 แผ่นเพื่อเริ่มถอดรหัส`;

                // กำหนด 4 ตำแหน่งรอบประตูกล
                this.panels = [];
                const centerX = this.canvas.width / 2;
                const centerY = this.canvas.height / 2;
                const spreadX = Math.min(this.canvas.width * 0.32, 280);
                const spreadY = Math.min(this.canvas.height * 0.22, 140);

                const positions = [
                    { x: centerX - spreadX, y: centerY - spreadY },
                    { x: centerX + spreadX, y: centerY - spreadY },
                    { x: centerX - spreadX, y: centerY + spreadY },
                    { x: centerX + spreadX, y: centerY + spreadY }
                ];

                for (let i = 0; i < 4; i++) {
                    const style = PANEL_STYLES[i % PANEL_STYLES.length];
                    this.panels.push({
                        id: i,
                        x: positions[i].x,
                        y: positions[i].y,
                        width: 130,
                        height: 165,
                        scale: 1,
                        opacity: 1,
                        isHovered: false,
                        floatOffset: Math.random() * Math.PI * 2,
                        styleType: style.type,
                        styleName: style.name,
                        motif: style.motif,
                        stoneColor: style.stoneColor,
                        crackProgress: 0
                    });
                }

                this.state = 'WAITING_PANEL';
            }

            selectPanel(panelIndex) {
                if (this.state !== 'WAITING_PANEL') return;
                this.selectedPanelIndex = panelIndex;
                this.state = 'PANEL_OPENING';
                this.audio.playStoneOpen();
                this.missionText.innerText = "✨ ผนึกโบราณเรืองแสง ร่องสลักกำลังเปิดออก...";

                // Animation เปิดหินทีละสเต็ป
                let stepTimer = 0;
                const animInterval = setInterval(() => {
                    stepTimer += 0.05;
                    this.lightRunProgress = Math.min(1, stepTimer);
                    this.panelOpenStep = Math.min(1, stepTimer);

                    if (stepTimer >= 1) {
                        clearInterval(animInterval);
                        this.spawnChoiceButtons();
                        this.state = 'WAITING_CHOICE';
                        this.missionText.innerText = "จงค้นหาตัวอักษรไทยปัจจุบันที่ตรงกับลายสือไทยสีทอง!";
                    }
                }, 30);
            }

            spawnChoiceButtons() {
                this.choices = [];
                const q = this.selectedQuestion;
                const totalChoices = q.choices.length;
                const btnWidth = Math.min(this.canvas.width * 0.18, 100);
                const btnHeight = 65;
                const gap = 18;
                const startX = (this.canvas.width - (totalChoices * btnWidth + (totalChoices - 1) * gap)) / 2;
                const posY = this.canvas.height - 110;

                q.choices.forEach((char, idx) => {
                    this.choices.push({
                        char: char,
                        x: startX + idx * (btnWidth + gap),
                        y: posY,
                        width: btnWidth,
                        height: btnHeight,
                        isHovered: false,
                        scale: 0,
                        isCorrect: (char === q.modernChar),
                        shakeOffset: 0
                    });
                });
            }

            triggerClick(x, y) {
                if (this.state === 'WAITING_PANEL') {
                    this.panels.forEach((p, idx) => {
                        if (x >= p.x - p.width / 2 && x <= p.x + p.width / 2 &&
                            y >= p.y - p.height / 2 && y <= p.y + p.height / 2) {
                            this.selectPanel(idx);
                        }
                    });
                } else if (this.state === 'WAITING_CHOICE') {
                    this.choices.forEach((choice) => {
                        if (x >= choice.x && x <= choice.x + choice.width &&
                            y >= choice.y && y <= choice.y + choice.height) {
                            this.selectChoice(choice);
                        }
                    });
                }
            }

            selectChoice(choice) {
                this.totalAttempts++;
                if (choice.isCorrect) {
                    // ตอบถูกต้อง
                    this.correctAnswers++;
                    this.score += 5;
                    this.comboCount++;
                    if (this.comboCount >= 3) {
                        this.score += 5; // Combo Bonus
                    }
                    this.wisdomPower = Math.min(5, this.wisdomPower + 1);
                    this.updateScoreUI();

                    // บันทึกลงสมุดนักโบราณคดี
                    this.saveToJournal(this.selectedQuestion);

                    this.audio.playCorrect();
                    this.state = 'DOOR_UNLOCK';
                    this.doorTargetProgress = 1;

                    setTimeout(() => {
                        this.audio.playDoorOpen();
                    }, 500);

                    setTimeout(() => {
                        this.showLevelSuccess();
                    }, 1800);

                } else {
                    // ตอบผิด (Non-punitive)
                    this.comboCount = 0;
                    this.updateScoreUI();
                    this.audio.playWrong();

                    // ทำ Animation สั่นปุ่มที่เลือก
                    choice.shakeOffset = 12;
                    setTimeout(() => { choice.shakeOffset = 0; }, 400);

                    // แสดงหน้าต่างคำแนะนำและตัวเลือกคำใบ้
                    setTimeout(() => {
                        this.showModal('wrong');
                    }, 350);
                }
            }

            saveToJournal(q) {
                const exists = this.archaeologistJournal.some(item => item.level === q.level);
                if (!exists) {
                    this.archaeologistJournal.push(q);
                    this.journalCountBadge.innerText = this.archaeologistJournal.length;
                }
            }

            renderJournalUI() {
                this.journalGrid.innerHTML = '';
                if (this.archaeologistJournal.length === 0) {
                    this.journalGrid.innerHTML = `
                        <div class="col-span-full text-center py-8 text-slate-400 text-xs">
                            ยังไม่มีบันทึกอักษรโบราณในสมุด<br>ถอดรหัสศิลาจารึกให้ถูกต้องเพื่อเก็บรวบรวม!
                        </div>
                    `;
                    return;
                }

                this.archaeologistJournal.forEach(item => {
                    const card = document.createElement('div');
                    card.className = "p-3 rounded-2xl bg-slate-900/80 border border-amber-500/30 flex items-start space-x-3";
                    card.innerHTML = `
                        <div class="w-12 h-12 rounded-xl bg-amber-500/20 border border-amber-400/50 flex items-center justify-center text-2xl text-yellow-300 font-bold font-game">
                            ${item.modernChar}
                        </div>
                        <div class="text-left flex-1">
                            <div class="text-xs font-bold text-yellow-300">${item.title}</div>
                            <div class="text-[11px] text-slate-300 mt-0.5 leading-relaxed">${item.explanation}</div>
                        </div>
                    `;
                    this.journalGrid.appendChild(card);
                });
            }

            updateScoreUI() {
                this.scoreDisplay.innerText = String(this.score).padStart(3, '0');
                const percent = (this.wisdomPower / 5) * 100;
                this.wisdomProgress.style.width = `${percent}%`;
                this.wisdomText.innerText = `${percent}%`;
                this.comboBadge.innerText = `x${this.comboCount} COMBO`;
            }

            showLevelSuccess() {
                this.state = 'LEVEL_COMPLETE';
                const q = this.selectedQuestion;
                document.getElementById('knowledgeTitle').innerText = `ถอดรหัสสำเร็จ: ตัวอักษร "${q.modernChar}"`;
                document.getElementById('knowledgeContent').innerText = q.explanation;
                this.showModal('knowledge');
            }

            nextLevel() {
                this.hideModals();
                if (this.currentLevelIdx + 1 < QUESTIONS_DB.length) {
                    this.loadLevel(this.currentLevelIdx + 1);
                } else {
                    this.showVictoryScreen();
                }
            }

            showVictoryScreen() {
                this.state = 'GAME_OVER';
                this.audio.playVictory();
                document.getElementById('finalScore').innerText = this.score;
                const acc = Math.round((this.correctAnswers / Math.max(1, this.totalAttempts)) * 100);
                document.getElementById('finalAccuracy').innerText = `${acc}%`;
                this.showModal('victory');
            }

            resetGame() {
                this.score = 0;
                this.wisdomPower = 0;
                this.comboCount = 0;
                this.correctAnswers = 0;
                this.totalAttempts = 0;
                this.archaeologistJournal = [];
                this.journalCountBadge.innerText = "0";
                this.updateScoreUI();
                this.startActualGame();
            }

            /**
             * 5. GAME LOOP & RENDERING ENGINE
             */
            gameLoop() {
                this.update();
                this.render();
                requestAnimationFrame(() => this.gameLoop());
            }

            update() {
                this.cursor.x += (this.cursor.targetX - this.cursor.x) * 0.35;
                this.cursor.y += (this.cursor.targetY - this.cursor.y) * 0.35;

                this.particles.forEach(p => {
                    p.x += p.speedX;
                    p.y += p.speedY;
                    if (p.y < 0) p.y = this.canvas.height;
                    if (p.x < 0) p.x = this.canvas.width;
                    if (p.x > this.canvas.width) p.x = 0;
                });

                this.doorOpenProgress += (this.doorTargetProgress - this.doorOpenProgress) * 0.05;

                const time = Date.now() * 0.003;
                this.panels.forEach((p, idx) => {
                    p.floatY = Math.sin(time + p.floatOffset) * 6;

                    const isHover = (this.cursor.x >= p.x - p.width / 2 && this.cursor.x <= p.x + p.width / 2 &&
                                     this.cursor.y >= (p.y + p.floatY) - p.height / 2 && this.cursor.y <= (p.y + p.floatY) + p.height / 2);
                    
                    if (isHover && !p.isHovered) this.audio.playHover();
                    p.isHovered = isHover;

                    if (this.state === 'PANEL_OPENING' || this.state === 'WAITING_CHOICE' || this.state === 'DOOR_UNLOCK') {
                        if (idx === this.selectedPanelIndex) {
                            p.x += ((this.canvas.width / 2) - p.x) * 0.1;
                            p.y += ((this.canvas.height / 2 - 40) - p.y) * 0.1;
                            p.scale += (1.4 - p.scale) * 0.1;
                        } else {
                            p.scale += (0 - p.scale) * 0.1;
                            p.opacity += (0 - p.opacity) * 0.1;
                        }
                    }
                });

                this.choices.forEach(c => {
                    c.scale += (1 - c.scale) * 0.15;
                    const isHover = (this.cursor.x >= c.x && this.cursor.x <= c.x + c.width &&
                                     this.cursor.y >= c.y && this.cursor.y <= c.y + c.height);
                    if (isHover && !c.isHovered) this.audio.playHover();
                    c.isHovered = isHover;
                });
            }

            render() {
                this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

                this.renderAncientGate();
                this.renderDustParticles();
                this.renderPanels();

                if (this.state === 'WAITING_CHOICE' || this.state === 'DOOR_UNLOCK') {
                    this.renderChoiceButtons();
                }

                if (this.tracker.showVisuals && this.handLandmarks) {
                    this.renderHandSkeleton();
                }
                this.renderCursor();
            }

            renderAncientGate() {
                const cx = this.canvas.width / 2;
                const cy = this.canvas.height / 2;
                const gateW = Math.min(this.canvas.width * 0.85, 480);
                const gateH = Math.min(this.canvas.height * 0.75, 540);

                this.ctx.save();
                this.ctx.translate(cx, cy);

                this.ctx.strokeStyle = "rgba(217, 119, 6, 0.4)";
                this.ctx.lineWidth = 6;
                this.ctx.strokeRect(-gateW / 2, -gateH / 2, gateW, gateH);

                this.ctx.beginPath();
                this.ctx.arc(0, 0, gateW * 0.38, 0, Math.PI * 2);
                this.ctx.strokeStyle = `rgba(245, 158, 11, ${0.3 + this.doorOpenProgress * 0.5})`;
                this.ctx.lineWidth = 4;
                this.ctx.stroke();

                const slideOffset = (gateW / 2) * this.doorOpenProgress;
                
                this.ctx.fillStyle = "rgba(30, 41, 59, 0.35)";
                this.ctx.fillRect(-gateW / 2 - slideOffset, -gateH / 2, gateW / 2, gateH);
                this.ctx.strokeStyle = "rgba(245, 158, 11, 0.5)";
                this.ctx.strokeRect(-gateW / 2 - slideOffset, -gateH / 2, gateW / 2, gateH);

                this.ctx.fillRect(slideOffset, -gateH / 2, gateW / 2, gateH);
                this.ctx.strokeRect(slideOffset, -gateH / 2, gateW / 2, gateH);

                if (this.doorOpenProgress < 0.8) {
                    this.ctx.fillStyle = "rgba(234, 179, 8, 0.8)";
                    this.ctx.font = "bold 24px 'Chakra Petch'";
                    this.ctx.textAlign = "center";
                    this.ctx.fillText("🪨 ประตูกลสุโขทัย 🪨", 0, -gateH / 2 + 40);
                }

                this.ctx.restore();
            }

            renderDustParticles() {
                this.ctx.save();
                this.particles.forEach(p => {
                    this.ctx.beginPath();
                    this.ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    this.ctx.fillStyle = `rgba(250, 204, 21, ${p.opacity})`;
                    this.ctx.fill();
                });
                this.ctx.restore();
            }

            /**
             * 6. RENDERING 4 DISTINCT SUKHOTHAI STONE PANELS
             */
            renderPanels() {
                this.panels.forEach((p, idx) => {
                    if (p.opacity <= 0.01) return;

                    this.ctx.save();
                    this.ctx.translate(p.x, p.y + (p.floatY || 0));
                    this.ctx.scale(p.scale, p.scale);
                    this.ctx.globalAlpha = p.opacity;

                    const isSelected = (idx === this.selectedPanelIndex);
                    const isOpenState = (isSelected && (this.state === 'PANEL_OPENING' || this.state === 'WAITING_CHOICE' || this.state === 'DOOR_UNLOCK'));

                    // วาดรูปทรงเฉพาะตัวของศิลาจารึกแต่ละแบบ
                    this.drawStoneGeometry(p);

                    // วาดลวดลายแกะสลักสุโขทัยตามแบบ
                    this.drawSukhothaiMotifs(p);

                    if (isOpenState) {
                        // Animation แสงวิ่งตามร่องสลัก
                        if (this.state === 'PANEL_OPENING') {
                            this.drawLightEnergyRays(p);
                        }
                        
                        // เมื่อแผ่นเปิดสมบูรณ์: แสดง "ตัวอักษรลายสือไทยสีทองเพียวๆ" ตรงกลาง ลอยเด่น
                        if (this.panelOpenStep > 0.4) {
                            const floatCharY = Math.sin(Date.now() * 0.005) * 4;
                            this.renderPureGoldenScript(this.selectedQuestion.ancientSvgType, 0, floatCharY);
                        }
                    } else {
                        // ก่อนเปิด: แสดงตราผนึกโบราณและชื่อศิลา
                        this.drawStoneSeal(p);
                    }

                    this.ctx.restore();
                });
            }

            drawStoneGeometry(p) {
                const w = p.width;
                const h = p.height;
                this.ctx.fillStyle = p.stoneColor;
                this.ctx.strokeStyle = p.isHovered ? "#fde047" : "rgba(217, 119, 6, 0.7)";
                this.ctx.lineWidth = p.isHovered ? 4 : 2.5;

                if (p.isHovered) {
                    this.ctx.shadowColor = "rgba(250, 204, 21, 0.85)";
                    this.ctx.shadowBlur = 22;
                }

                this.ctx.beginPath();
                if (p.styleType === 'lotus') {
                    // ทรงยอดกลีบบัว: โค้งแหลมด้านบน
                    this.ctx.moveTo(0, -h / 2);
                    this.ctx.quadraticCurveTo(w / 2, -h / 2 + 25, w / 2, -h / 4);
                    this.ctx.lineTo(w / 2, h / 2 - 10);
                    this.ctx.quadraticCurveTo(w / 2, h / 2, w / 2 - 10, h / 2);
                    this.ctx.lineTo(-w / 2 + 10, h / 2);
                    this.ctx.quadraticCurveTo(-w / 2, h / 2, -w / 2, h / 2 - 10);
                    this.ctx.lineTo(-w / 2, -h / 4);
                    this.ctx.quadraticCurveTo(-w / 2, -h / 2 + 25, 0, -h / 2);
                } else if (p.styleType === 'prang') {
                    // ทรงซุ้มปรางค์: มีหยักซุ้ม 3 ยอด
                    this.ctx.moveTo(0, -h / 2);
                    this.ctx.lineTo(w / 4, -h / 2 + 15);
                    this.ctx.lineTo(w / 2, -h / 2 + 30);
                    this.ctx.lineTo(w / 2, h / 2);
                    this.ctx.lineTo(-w / 2, h / 2);
                    this.ctx.lineTo(-w / 2, -h / 2 + 30);
                    this.ctx.lineTo(-w / 4, -h / 2 + 15);
                    this.ctx.closePath();
                } else if (p.styleType === 'sema') {
                    // ทรงใบเสมาหินทราย: มีเอวคอดตรงกลาง
                    this.ctx.moveTo(0, -h / 2);
                    this.ctx.quadraticCurveTo(w / 2, -h / 3, w / 2 - 10, 0);
                    this.ctx.quadraticCurveTo(w / 2 + 5, h / 3, w / 2 - 5, h / 2);
                    this.ctx.lineTo(-w / 2 + 5, h / 2);
                    this.ctx.quadraticCurveTo(-w / 2 - 5, h / 3, -w / 2 + 10, 0);
                    this.ctx.quadraticCurveTo(-w / 2, -h / 3, 0, -h / 2);
                } else {
                    // ทรงศิลาจารึกหลักมน (ทรงหลักศิลาจารึกพ่อขุนรามคำแหงฯ)
                    this.ctx.arc(0, -h / 2 + w / 2, w / 2, Math.PI, 0);
                    this.ctx.lineTo(w / 2, h / 2 - 10);
                    this.ctx.quadraticCurveTo(w / 2, h / 2, w / 2 - 10, h / 2);
                    this.ctx.lineTo(-w / 2 + 10, h / 2);
                    this.ctx.quadraticCurveTo(-w / 2, h / 2, -w / 2, h / 2 - 10);
                    this.ctx.closePath();
                }
                this.ctx.fill();
                this.ctx.stroke();
            }

            drawSukhothaiMotifs(p) {
                this.ctx.save();
                this.ctx.strokeStyle = "rgba(245, 158, 11, 0.35)";
                this.ctx.lineWidth = 1.5;

                const w = p.width * 0.75;
                const h = p.height * 0.75;

                // วาดลายเส้นขอบประดับด้านใน
                this.ctx.strokeRect(-w / 2, -h / 2 + 10, w, h);

                // ลายสลักมุม
                this.ctx.beginPath();
                this.ctx.arc(-w / 2 + 8, -h / 2 + 18, 4, 0, Math.PI * 2);
                this.ctx.arc(w / 2 - 8, -h / 2 + 18, 4, 0, Math.PI * 2);
                this.ctx.arc(-w / 2 + 8, h / 2 + 2, 4, 0, Math.PI * 2);
                this.ctx.arc(w / 2 - 8, h / 2 + 2, 4, 0, Math.PI * 2);
                this.ctx.fillStyle = "rgba(234, 179, 8, 0.4)";
                this.ctx.fill();

                this.ctx.restore();
            }

            drawStoneSeal(p) {
                this.ctx.save();
                // ตราผนึกวงเวทสุโขทัย
                this.ctx.beginPath();
                this.ctx.arc(0, -8, 26, 0, Math.PI * 2);
                this.ctx.fillStyle = "rgba(15, 23, 42, 0.85)";
                this.ctx.fill();
                this.ctx.strokeStyle = p.isHovered ? "#facc15" : "rgba(245, 158, 11, 0.7)";
                this.ctx.lineWidth = 2;
                this.ctx.stroke();

                // ตราสัญลักษณ์ 4 แบบ
                const icons = { lotus: "🪷", prang: "🏛️", sema: "📜", pillar: "🗿" };
                this.ctx.font = "24px sans-serif";
                this.ctx.textAlign = "center";
                this.ctx.textBaseline = "middle";
                this.ctx.fillText(icons[p.styleType] || "📜", 0, -8);

                // ชื่อเฉพาะของแผ่นศิลา
                this.ctx.font = "bold 11px 'Mitr'";
                this.ctx.fillStyle = "#fef08a";
                this.ctx.fillText(p.styleName, 0, 38);

                this.ctx.font = "9px 'Sarabun'";
                this.ctx.fillStyle = "rgba(254, 240, 138, 0.7)";
                this.ctx.fillText(p.motif, 0, 52);

                this.ctx.restore();
            }

            drawLightEnergyRays(p) {
                this.ctx.save();
                this.ctx.strokeStyle = `rgba(253, 224, 71, ${0.8 * this.lightRunProgress})`;
                this.ctx.lineWidth = 4;
                this.ctx.shadowColor = "#eab308";
                this.ctx.shadowBlur = 20;

                // เส้นแสงวิ่งแผ่ออกจากศูนย์กลางตามร่องสลัก
                const len = 45 * this.lightRunProgress;
                for (let i = 0; i < 6; i++) {
                    const angle = (i * Math.PI / 3) + (Date.now() * 0.004);
                    this.ctx.beginPath();
                    this.ctx.moveTo(0, 0);
                    this.ctx.lineTo(Math.cos(angle) * len, Math.sin(angle) * len);
                    this.ctx.stroke();
                }
                this.ctx.restore();
            }

            /**
             * 7. RENDERING PURE GOLDEN SUKHOTHAI SCRIPT (ตัวอักษรสีทองเพียวๆ ไร้สิ่งประดับ)
             */
            renderPureGoldenScript(type, x, y) {
                this.ctx.save();
                this.ctx.translate(x, y);

                // Golden Glowing Aura
                this.ctx.strokeStyle = "#facc15";
                this.ctx.lineWidth = 8;
                this.ctx.lineCap = "round";
                this.ctx.lineJoin = "round";
                this.ctx.shadowColor = "#eab308";
                this.ctx.shadowBlur = 25;

                this.ctx.beginPath();
                if (type === 'char_kor') {
                    // ลายสือไทย 'ก'
                    this.ctx.moveTo(-25, 30);
                    this.ctx.lineTo(-25, -10);
                    this.ctx.quadraticCurveTo(-15, -35, 5, -30);
                    this.ctx.lineTo(20, -15);
                    this.ctx.lineTo(20, 30);
                } else if (type === 'char_nor') {
                    // ลายสือไทย 'น'
                    this.ctx.moveTo(-20, -25);
                    this.ctx.lineTo(-20, 20);
                    this.ctx.lineTo(15, 20);
                    this.ctx.lineTo(15, -25);
                } else if (type === 'char_mor') {
                    // ลายสือไทย 'ม'
                    this.ctx.moveTo(-25, -25);
                    this.ctx.lineTo(-25, 25);
                    this.ctx.lineTo(0, 0);
                    this.ctx.lineTo(25, 25);
                    this.ctx.lineTo(25, -25);
                } else if (type === 'char_sor') {
                    // ลายสือไทย 'ส'
                    this.ctx.moveTo(-20, 25);
                    this.ctx.lineTo(-20, -10);
                    this.ctx.quadraticCurveTo(0, -35, 20, -10);
                    this.ctx.lineTo(20, 25);
                    this.ctx.moveTo(15, -20);
                    this.ctx.lineTo(30, -35);
                } else {
                    // ลายสือไทย 'ไ'
                    this.ctx.moveTo(-15, 30);
                    this.ctx.lineTo(-15, -10);
                    this.ctx.lineTo(5, -35);
                    this.ctx.lineTo(-5, -45);
                }
                this.ctx.stroke();

                // Inner Bright Stroke
                this.ctx.strokeStyle = "#ffffff";
                this.ctx.lineWidth = 3;
                this.ctx.stroke();

                this.ctx.restore();
            }

            renderChoiceButtons() {
                this.choices.forEach(c => {
                    this.ctx.save();
                    this.ctx.translate(c.x + c.width / 2 + (c.shakeOffset || 0), c.y + c.height / 2);
                    this.ctx.scale(c.scale, c.scale);

                    if (c.isHovered) {
                        this.ctx.shadowColor = "rgba(250, 204, 21, 0.9)";
                        this.ctx.shadowBlur = 18;
                    }

                    this.ctx.fillStyle = c.isHovered ? "rgba(234, 179, 8, 0.45)" : "rgba(15, 23, 42, 0.85)";
                    this.ctx.beginPath();
                    this.ctx.roundRect(-c.width / 2, -c.height / 2, c.width, c.height, 16);
                    this.ctx.fill();

                    this.ctx.strokeStyle = c.isHovered ? "#fde047" : "rgba(217, 119, 6, 0.6)";
                    this.ctx.lineWidth = c.isHovered ? 3.5 : 2;
                    this.ctx.stroke();

                    this.ctx.fillStyle = c.isHovered ? "#ffffff" : "#fef08a";
                    this.ctx.font = "bold 28px 'Mitr'";
                    this.ctx.textAlign = "center";
                    this.ctx.textBaseline = "middle";
                    this.ctx.fillText(c.char, 0, 0);

                    this.ctx.restore();
                });
            }

            renderHandSkeleton() {
                if (!this.handLandmarks) return;
                const w = this.canvas.width;
                const h = this.canvas.height;
                const lm = this.handLandmarks;

                const connections = [
                    [0,1],[1,2],[2,3],[3,4],
                    [0,5],[5,6],[6,7],[7,8],
                    [0,9],[9,10],[10,11],[11,12],
                    [0,13],[13,14],[14,15],[15,16],
                    [0,17],[17,18],[18,19],[19,20]
                ];

                this.ctx.save();
                this.ctx.strokeStyle = "rgba(250, 204, 21, 0.35)";
                this.ctx.lineWidth = 2.5;

                connections.forEach(([i, j]) => {
                    this.ctx.beginPath();
                    this.ctx.moveTo((1 - lm[i].x) * w, lm[i].y * h);
                    this.ctx.lineTo((1 - lm[j].x) * w, lm[j].y * h);
                    this.ctx.stroke();
                });

                lm.forEach(pt => {
                    this.ctx.beginPath();
                    this.ctx.arc((1 - pt.x) * w, pt.y * h, 3.5, 0, Math.PI * 2);
                    this.ctx.fillStyle = "rgba(234, 179, 8, 0.7)";
                    this.ctx.fill();
                });

                this.ctx.restore();
            }

            renderCursor() {
                const { x, y, isPinching } = this.cursor;
                if (x < 0 || y < 0) return;

                this.ctx.save();
                this.ctx.translate(x, y);

                this.ctx.beginPath();
                this.ctx.arc(0, 0, isPinching ? 18 : 26, 0, Math.PI * 2);
                this.ctx.strokeStyle = isPinching ? "#22c55e" : "#facc15";
                this.ctx.lineWidth = 3;
                this.ctx.shadowColor = isPinching ? "#4ade80" : "#eab308";
                this.ctx.shadowBlur = 15;
                this.ctx.stroke();

                this.ctx.beginPath();
                this.ctx.arc(0, 0, isPinching ? 8 : 5, 0, Math.PI * 2);
                this.ctx.fillStyle = isPinching ? "#86efac" : "#ffffff";
                this.ctx.fill();

                if (this.isHandDetected && !isPinching) {
                    this.ctx.font = "10px 'Mitr'";
                    this.ctx.fillStyle = "rgba(254, 240, 138, 0.9)";
                    this.ctx.textAlign = "center";
                    this.ctx.fillText("☝️ ชี้ / 🤏 จีบ", 0, 38);
                }

                this.ctx.restore();
            }
        }

        // Initialize Game Instance
        window.addEventListener('DOMContentLoaded', () => {
            window.game = new SukhothaiARGame();
        });
    </script>
</body>
</html>
