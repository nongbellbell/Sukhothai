                hint: "พยัญชนะตัวที่สอง อยู่ในหมวดอักษรสูง",
                fact: "ลายสือไทยสมัยพ่อขุนรามคำแหงมีการประดิษฐ์ขึ้นเพื่อให้เขียนง่ายและรวดเร็วต่อเนื่อง",
                room: 1
            },
            {
                ancientChar: "ง",
                ancientSvg: `<svg viewBox="0 0 100 100" class="w-16 h-16 stroke-current fill-none stroke-[6]"><path d="M 40 25 L 55 55 L 30 75" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
                modern: "ง",
                choices: ["ง", "ว", "จ", "ร"],
                hint: "เสียงนาสิก (ขึ้นจมูก) เส้นหางยาวลงมาด้านล่างซ้าย",
                fact: "อักษร 'ง' โบราณมีลักษณะลากเส้นหักมุมชัดเจนเพื่อแกะสลักบนเนื้อหินได้ง่าย",
                room: 1
            },
            {
                ancientChar: "จ",
                ancientSvg: `<svg viewBox="0 0 100 100" class="w-16 h-16 stroke-current fill-none stroke-[6]"><path d="M 45 25 L 35 55 Q 35 75 60 75 Q 65 55 45 55" stroke-linecap="round"/></svg>`,
                modern: "จ",
                choices: ["จ", "ฉ", "ฐ", "ล"],
                hint: "เป็นพยัญชนะในคำว่า 'จริงใจ' มีเส้นวนคล้ายก้นหอย",
                fact: "ศิลาจารึกสุโขทัยหลักที่ 1 ถูกค้นพบโดยพระบาทสมเด็จพระจอมเกล้าเจ้าอยู่หัว (ร.4)",
                room: 1
            },
            {
                ancientChar: "ด",
                ancientSvg: `<svg viewBox="0 0 100 100" class="w-16 h-16 stroke-current fill-none stroke-[6]"><path d="M 35 75 L 35 35 Q 50 20 65 35 L 65 75" stroke-linecap="round"/></svg>`,
                modern: "ด",
                choices: ["ด", "ต", "ค", "ท"],
                hint: "อักษรกลาง ออกเสียงเหมือน 'เด็ก'",
                fact: "ลายสือไทยยุคแรก สระจะวางเรียงอยู่ในบรรทัดเดียวกันกับพยัญชนะ",
                room: 1
            },

            // Room 2: พยัญชนะเสียงกักและเสียดแทรก
            {
                ancientChar: "ต",
                ancientSvg: `<svg viewBox="0 0 100 100" class="w-16 h-16 stroke-current fill-none stroke-[6]"><path d="M 30 75 L 30 40 Q 40 25 50 40 Q 60 25 70 40 L 70 75" stroke-linecap="round"/></svg>`,
