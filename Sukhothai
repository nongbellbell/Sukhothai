        /* ==========================================================================
           2. AUDIO SYNTHESIZER (WEB AUDIO API - NO EXTERNAL ASSETS)
           ========================================================================== */
        class AudioManager {
            constructor() {
                this.ctx = null;
                this.soundEnabled = true;
            }

            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) this.ctx = new AudioCtx();
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            playTone(freq, type, duration, gainVal = 0.1) {
                if (!this.soundEnabled) return;
                this.init();
                if (!this.ctx) return;

                try {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = type;
                    osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
                    gain.gain.setValueAtTime(gainVal, this.ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + duration);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start();
                    osc.stop(this.ctx.currentTime + duration);
                } catch (e) {
                    console.warn("Audio play error", e);
                }
            }

            playHover() { this.playTone(320, 'sine', 0.08, 0.04); }
            playClick() { this.playTone(520, 'triangle', 0.12, 0.08); }
            
            playCorrect() {
                if (!this.soundEnabled) return;
                this.init();
                // Melodic chime
                [523.25, 659.25, 783.99, 1046.50].forEach((freq, i) => {
                    setTimeout(() => this.playTone(freq, 'sine', 0.25, 0.08), i * 70);
                });
            }

            playWrong() {
                if (!this.soundEnabled) return;
                this.init();
                this.playTone(180, 'sawtooth', 0.25, 0.08);
            }

            playDoorOpen() {
                if (!this.soundEnabled) return;
                this.init();
                [220, 277.18, 329.63, 440, 554.37].forEach((freq, i) => {
                    setTimeout(() => this.playTone(freq, 'triangle', 0.5, 0.1), i * 100);
                });
            }

            playVictory() {
                if (!this.soundEnabled) return;
                this.init();
                const notes = [440, 554.37, 659.25, 880, 1108.73];
                notes.forEach((f, i) => setTimeout(() => this.playTone(f, 'sine', 0.6, 0.12), i * 120));
            }
        }

        /* ==========================================================================
           3. PARTICLE & ANIMATION SYSTEM (HIGH PERFORMANCE CANVAS 2D)
           ========================================================================== */
        class ParticleSystem {
            constructor() {
                this.particles = [];
                this.maxParticles = 120;
            }

            spawnDust(width, height) {
                if (this.particles.length < this.maxParticles && Math.random() < 0.2) {
                    this.particles.push({
                        x: Math.random() * width,
                        y: Math.random() * height,
                        vx: (Math.random() - 0.5) * 0.4,
                        vy: -Math.random() * 0.5 - 0.1,
                        size: Math.random() * 2.5 + 1,
                        alpha: Math.random() * 0.6 + 0.2,
                        color: 'rgba(245, 158, 11,',
                        life: 1,
                        decay: Math.random() * 0.005 + 0.002
                    });
                }
            }

            createBurst(x, y, count = 25, color = 'rgba(251, 191, 36,') {
                for (let i = 0; i < count; i++) {
                    const angle = Math.random() * Math.PI * 2;
                    const speed = Math.random() * 4 + 1.5;
                    this.particles.push({
                        x: x,
                        y: y,
                        vx: Math.cos(angle) * speed,
                        vy: Math.sin(angle) * speed,
                        size: Math.random() * 4 + 2,
                        alpha: 1,
                        color: color,
                        life: 1,
                        decay: Math.random() * 0.02 + 0.015
                    });
                }
            }

            update(width, height) {
                this.spawnDust(width, height);
                for (let i = this.particles.length - 1; i >= 0; i--) {
                    const p = this.particles[i];
                    p.x += p.vx;
                    p.y += p.vy;
                    p.life -= p.decay;

                    if (p.life <= 0 || p.x < 0 || p.x > width || p.y < 0 || p.y > height) {
                        this.particles.splice(i, 1);
                    }
                }
            }

            draw(ctx) {
                ctx.save();
                for (let i = 0; i < this.particles.length; i++) {
                    const p = this.particles[i];
                    ctx.fillStyle = `${p.color} ${p.alpha * p.life})`;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                }
                ctx.restore();
            }
        }

        /* ==========================================================================
           4. STONE PLATE & DOOR SCENE GRAPH
           ========================================================================== */
        class StonePlate {
            constructor(id, index, total, questionData) {
                this.id = id;
                this.index = index;
                this.total = total;
                this.questionData = questionData;
                this.isSolved = false;
                this.isHovered = false;
                this.scale = 1;
                this.glowAnim = 0;
                this.x = 0;
                this.y = 0;
                this.radius = 42; // Hit radius for pinch/click
            }

            layout(canvasWidth, canvasHeight) {
                // Circular & arc layout around the central door
                const centerX = canvasWidth / 2;
                const centerY = canvasHeight * 0.52;
                const isMobile = canvasWidth < 640;
                const radiusX = isMobile ? canvasWidth * 0.38 : canvasWidth * 0.32;
                const radiusY = isMobile ? canvasHeight * 0.28 : canvasHeight * 0.24;

                const angleStep = Math.PI / (this.total + 1);
                const angle = Math.PI + angleStep * (this.index + 1);

                this.x = centerX + Math.cos(angle) * radiusX;
                this.y = centerY + Math.sin(angle) * radiusY;
                this.radius = isMobile ? 36 : 46;
            }

            update(timestamp) {
                this.glowAnim = Math.sin(timestamp * 0.003 + this.index) * 0.3 + 0.7;
                if (this.isHovered) {
                    this.scale += (1.12 - this.scale) * 0.2;
                } else {
                    this.scale += (1.0 - this.scale) * 0.2;
                }
            }

            draw(ctx) {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.scale(this.scale, this.scale);

                // Plate Shadow
                ctx.shadowColor = this.isSolved ? 'rgba(34, 197, 94, 0.4)' : (this.isHovered ? 'rgba(245, 158, 11, 0.7)' : 'rgba(0,0,0,0.5)');
                ctx.shadowBlur = this.isHovered ? 25 : 12;

                // Ancient Tablet Body
                const r = this.radius;
                ctx.fillStyle = this.isSolved ? '#14532d' : (this.isHovered ? '#78350f' : '#292524');
                ctx.strokeStyle = this.isSolved ? '#4ade80' : (this.isHovered ? '#fbbf24' : '#78716c');
                ctx.lineWidth = this.isHovered ? 4 : 2.5;

                // Tablet rounded rect shape
                ctx.beginPath();
                ctx.roundRect(-r, -r, r * 2, r * 2, 14);
                ctx.fill();
                ctx.stroke();

                // Inner Engraving Border
                ctx.strokeStyle = this.isSolved ? 'rgba(74, 222, 128, 0.3)' : 'rgba(217, 119, 6, 0.25)';
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.roundRect(-r + 6, -r + 6, (r - 6) * 2, (r - 6) * 2, 8);
                ctx.stroke();

                // Plate Center Icon
                ctx.fillStyle = this.isSolved ? '#86efac' : (this.isHovered ? '#fef08a' : '#d6d3d1');
                ctx.font = `bold ${Math.floor(r * 0.65)}px Kanit`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';

                if (this.isSolved) {
                    ctx.fillText('✓', 0, 0);
                } else {
                    // Ancient glyph hint mark
                    ctx.fillText(this.questionData.ancientChar, 0, 0);
                }

                // Interactive Hint when hovered
                if (this.isHovered && !this.isSolved) {
                    ctx.fillStyle = '#fef3c7';
                    ctx.font = 'bold 11px Kanit';
                    ctx.fillText('🤏 จีบนิ้วเปิด', 0, r + 18);
                }

                ctx.restore();
            }

            contains(px, py) {
                const dx = px - this.x;
                const dy = py - this.y;
                return (dx * dx + dy * dy) <= (this.radius * 1.3) * (this.radius * 1.3);
            }
        }

        class AncientDoor {
            constructor() {
                this.openProgress = 0; // 0 (closed) to 1 (fully open)
                this.isOpening = false;
                this.glow = 0;
            }

            reset() {
                this.openProgress = 0;
                this.isOpening = false;
            }

            triggerOpen() {
                this.isOpening = true;
            }

            update() {
                if (this.isOpening && this.openProgress < 1) {
                    this.openProgress += 0.02;
                    if (this.openProgress > 1) this.openProgress = 1;
                }
                this.glow = (this.glow + 0.05) % (Math.PI * 2);
            }

            draw(ctx, canvasWidth, canvasHeight, roomNumber) {
                const centerX = canvasWidth / 2;
                const centerY = canvasHeight * 0.52;
                const isMobile = canvasWidth < 640;
                const doorW = isMobile ? 140 : 200;
                const doorH = isMobile ? 180 : 260;

                ctx.save();
                ctx.translate(centerX, centerY);

                // Door Frame Glow
                ctx.shadowColor = this.openProgress > 0 ? 'rgba(56, 189, 248, 0.8)' : 'rgba(217, 119, 6, 0.3)';
                ctx.shadowBlur = 20 + Math.sin(this.glow) * 10;

                // Outer Arch
                ctx.fillStyle = '#1c1917';
                ctx.strokeStyle = '#d97706';
                ctx.lineWidth = 4;
                ctx.beginPath();
                ctx.arc(0, -doorH / 4, doorW / 2 + 10, Math.PI, 0);
                ctx.lineTo(doorW / 2 + 10, doorH / 2);
                ctx.lineTo(-doorW / 2 - 10, doorH / 2);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                // Inner Portal Light (Revealed when door opens)
                if (this.openProgress > 0) {
                    ctx.save();
                    const gradient = ctx.createRadialGradient(0, 0, 10, 0, 0, doorW);
                    gradient.addColorStop(0, '#ffffff');
                    gradient.addColorStop(0.3, '#38bdf8');
                    gradient.addColorStop(0.8, '#0369a1');
                    gradient.addColorStop(1, '#0c4a6e');
                    ctx.fillStyle = gradient;
                    ctx.globalAlpha = Math.min(1, this.openProgress * 1.5);
                    ctx.fillRect(-doorW / 2, -doorH / 2, doorW, doorH);
                    ctx.restore();
                }

                // Sliding Left & Right Stone Doors
                const slideOffset = (doorW / 2) * this.openProgress;

                // Left Door
                ctx.fillStyle = '#292524';
                ctx.strokeStyle = '#a8a29e';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.rect(-doorW / 2 - slideOffset, -doorH / 2, doorW / 2, doorH);
                ctx.fill();
                ctx.stroke();

                // Right Door
                ctx.beginPath();
                ctx.rect(slideOffset, -doorH / 2, doorW / 2, doorH);
                ctx.fill();
                ctx.stroke();

                // Ancient Inscription on Closed Door
                if (this.openProgress < 0.3) {
                    ctx.fillStyle = '#f59e0b';
                    ctx.font = `bold ${isMobile ? '12px' : '16px'} Kanit`;
                    ctx.textAlign = 'center';
                    ctx.fillText(`ศิลาทวารที่ ${roomNumber}`, 0, 0);
                    ctx.font = '10px Kanit';
                    ctx.fillStyle = '#a8a29e';
                    ctx.fillText('สุโขทัยธานี', 0, 20);
                }

                ctx.restore();
            }
        }

        /* ==========================================================================
           5. CURSOR & INTERACTION SYSTEM
           ========================================================================== */
        class Cursor {
            constructor() {
                this.x = window.innerWidth / 2;
                this.y = window.innerHeight / 2;
                this.targetX = this.x;
                this.targetY = this.y;
                this.isPinching = false;
                this.pinchCooldown = false;
                this.trail = [];
            }

            update() {
                // Smooth Lerp
                this.x += (this.targetX - this.x) * 0.35;
                this.y += (this.targetY - this.y) * 0.35;

                // Trail
                this.trail.push({ x: this.x, y: this.y, alpha: 1.0 });
                if (this.trail.length > 8) this.trail.shift();
                for (let t of this.trail) t.alpha *= 0.75;
            }

            draw(ctx) {
                // Draw Trail
                for (let i = 0; i < this.trail.length; i++) {
                    const t = this.trail[i];
                    ctx.beginPath();
                    ctx.arc(t.x, t.y, (i + 1) * 1.5, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(245, 158, 11, ${t.alpha * 0.4})`;
                    ctx.fill();
                }

                // Draw Cursor Ring
                ctx.save();
                ctx.translate(this.x, this.y);

                ctx.shadowColor = this.isPinching ? '#38bdf8' : '#f59e0b';
                ctx.shadowBlur = this.isPinching ? 20 : 12;

                ctx.beginPath();
                ctx.arc(0, 0, this.isPinching ? 10 : 16, 0, Math.PI * 2);
                ctx.strokeStyle = this.isPinching ? '#38bdf8' : '#fbbf24';
                ctx.lineWidth = this.isPinching ? 4 : 2.5;
                ctx.stroke();

                ctx.beginPath();
                ctx.arc(0, 0, this.isPinching ? 6 : 4, 0, Math.PI * 2);
                ctx.fillStyle = this.isPinching ? '#ffffff' : '#fbbf24';
                ctx.fill();

                ctx.restore();
            }
        }

        /* ==========================================================================
           6. MAIN GAME ENGINE
           ========================================================================== */
        class SukhothaiARGame {
            constructor() {
                // Canvas & Context
                this.canvas = document.getElementById('gameCanvas');
                this.ctx = this.canvas.getContext('2d');
                this.dpr = window.devicePixelRatio || 1;

                // Managers
                this.audio = new AudioManager();
                this.particles = new ParticleSystem();
                this.cursor = new Cursor();
                this.door = new AncientDoor();

                // Game State
                this.state = GAME_STATES.START;
                this.currentRoom = 1;
                this.totalRooms = 5;
                this.score = 0;
                this.wisdom = 0; // 0 to 5 per room
                this.combo = 0;
                this.maxCombo = 0;
                this.plates = [];
                this.activePlate = null;
                this.answeredCount = 0;

                // MediaPipe & Camera State
                this.hands = null;
                this.camera = null;
                this.handLandmarks = null;
                this.isPinchActive = false;
                this.wasPinching = false;
                this.pinchCooldownTimer = null;
                this.arReady = false;

                // UI Elements Cache
                this.hud = {
                    room: document.getElementById('hud-room'),
                    score: document.getElementById('hud-score'),
                    wisdom: document.getElementById('hud-wisdom'),
                    wisdomBar: document.getElementById('wisdom-bar'),
                    combo: document.getElementById('hud-combo'),
                    comboBox: document.getElementById('hud-combo-box'),
                    camStatus: document.getElementById('camera-status'),
                    handStatus: document.getElementById('hand-status')
                };

                this.screens = {
                    start: document.getElementById('screen-start'),
                    tutorial: document.getElementById('screen-tutorial'),
                    questionModal: document.getElementById('modal-question'),
                    roomIntro: document.getElementById('banner-room-intro'),
                    roomComplete: document.getElementById('screen-room-complete'),
                    final: document.getElementById('screen-final')
                };

                this.initDOMEvents();
                this.resize();
                window.addEventListener('resize', () => this.resize());

                // Setup MediaPipe
                this.setupMediaPipe();

                // Start Main Loop
                requestAnimationFrame((t) => this.gameLoop(t));
            }

            resize() {
                this.canvas.width = window.innerWidth * this.dpr;
                this.canvas.height = window.innerHeight * this.dpr;
                this.ctx.scale(this.dpr, this.dpr);
                if (this.plates.length > 0) {
                    this.plates.forEach(p => p.layout(window.innerWidth, window.innerHeight));
                }
            }

            /* ======================================================================
               MediaPipe Hands & AR Tracking Integration
               ====================================================================== */
            setupMediaPipe() {
                const videoElement = document.getElementById('webcam');

                try {
                    this.hands = new Hands({
                        locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
                    });

                    this.hands.setOptions({
                        maxNumHands: 1,
                        modelComplexity: 1,
                        minDetectionConfidence: 0.5,
                        minTrackingConfidence: 0.5
                    });

                    // Strictly process landmarks only in onResults
                    this.hands.onResults((results) => {
                        if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
                            this.handLandmarks = results.multiHandLandmarks[0];
                            this.hud.handStatus.textContent = "🟢 ตรวจพบมือ";
                            this.hud.handStatus.className = "text-green-400 font-semibold";
                            this.processHandGestures(this.handLandmarks);
                        } else {
                            this.handLandmarks = null;
                            this.hud.handStatus.textContent = "✋ ไม่พบมือ";
                            this.hud.handStatus.className = "text-gray-400";
                        }
                    });

                    // Camera Setup
                    if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                        this.camera = new Camera(videoElement, {
                            onFrame: async () => {
                                await this.hands.send({ image: videoElement });
                            },
                            width: 640,
                            height: 480
                        });

                        this.camera.start().then(() => {
                            this.arReady = true;
                            this.hud.camStatus.textContent = "🟢 AR: พร้อมใช้งาน";
                            this.hud.camStatus.className = "text-green-400 font-bold";
                        }).catch((err) => {
                            console.warn("Camera access denied/error:", err);
                            this.fallbackToMouse("📷 ไม่พบกล้อง (ใช้เมาส์/สัมผัสได้)");
                        });
                    } else {
                        this.fallbackToMouse("📷 อุปกรณ์ไม่รองรับกล้อง");
                    }
                } catch (e) {
                    console.error("MediaPipe initialization error", e);
                    this.fallbackToMouse("⚠️ AR โหลดไม่สำเร็จ (ใช้เมาส์ได้)");
                }
            }

            fallbackToMouse(message) {
                this.arReady = false;
                this.hud.camStatus.textContent = message;
                this.hud.camStatus.className = "text-amber-400";
            }

            processHandGestures(landmarks) {
                // Landmark 8: Index Finger Tip, Landmark 4: Thumb Tip
                const indexTip = landmarks[8];
                const thumbTip = landmarks[4];
                const middleTip = landmarks[12];
                const ringTip = landmarks[16];

                // Mirrored coordinates for intuitive interaction
                const screenW = window.innerWidth;
                const screenH = window.innerHeight;
                this.cursor.targetX = (1 - indexTip.x) * screenW;
                this.cursor.targetY = indexTip.y * screenH;

                // Pinch Calculation
                const dx = (1 - thumbTip.x) - (1 - indexTip.x);
                const dy = thumbTip.y - indexTip.y;
                const distance = Math.sqrt(dx * dx + dy * dy);

                const PINCH_THRESHOLD = 0.075;
                const isPinchingNow = distance < PINCH_THRESHOLD;

                // Pinch Debounce & Trigger
                if (isPinchingNow && !this.wasPinching && !this.cursor.pinchCooldown) {
                    this.cursor.isPinching = true;
                    this.handlePinchClick(this.cursor.targetX, this.cursor.targetY);
                    
                    // Cooldown Debounce to prevent multiple triggers
                    this.cursor.pinchCooldown = true;
                    setTimeout(() => {
                        this.cursor.pinchCooldown = false;
                    }, 400);
                } else if (!isPinchingNow) {
                    this.cursor.isPinching = false;
                }
                this.wasPinching = isPinchingNow;

                // Gesture: Open Palm (Check if all fingers are spread open)
                if (indexTip.y < landmarks[6].y && middleTip.y < landmarks[10].y && ringTip.y < landmarks[14].y && distance > 0.18) {
                    this.handleOpenPalm();
                }
            }

            /* ======================================================================
               Pointer / Touch / Fallback Input Handling
               ====================================================================== */
            initDOMEvents() {
                // Global pointer listener for Mouse / Touch Fallback
                window.addEventListener('pointerdown', (e) => {
                    this.cursor.targetX = e.clientX;
                    this.cursor.targetY = e.clientY;
                    this.cursor.x = e.clientX;
                    this.cursor.y = e.clientY;
                    this.handlePinchClick(e.clientX, e.clientY);
                });

                window.addEventListener('pointermove', (e) => {
                    if (!this.handLandmarks) {
                        this.cursor.targetX = e.clientX;
                        this.cursor.targetY = e.clientY;
                    }
                });

                // Keyboard Accessibility
                window.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') this.handleOpenPalm();
                    if (e.key === 'h' || e.key === 'H') this.triggerHint();
                });

                // UI Buttons Binding
                document.getElementById('btn-start').addEventListener('click', () => {
                    this.audio.playClick();
                    this.startRoom(1);
                });

                document.getElementById('btn-tutorial').addEventListener('click', () => {
                    this.audio.playClick();
                    this.showScreen('tutorial');
                });

                document.getElementById('btn-tut-close').addEventListener('click', () => {
                    this.audio.playClick();
                    this.startRoom(1);
                });

                document.getElementById('btn-modal-close').addEventListener('click', () => {
                    this.audio.playClick();
                    this.closeQuestionModal();
                });

                document.getElementById('btn-modal-hint').addEventListener('click', () => {
                    this.triggerHint();
                });

                document.getElementById('btn-next-room').addEventListener('click', () => {
                    this.audio.playClick();
                    if (this.currentRoom < this.totalRooms) {
                        this.startRoom(this.currentRoom + 1);
                    } else {
                        this.showFinalTreasure();
                    }
                });

                document.getElementById('btn-restart').addEventListener('click', () => {
                    this.audio.playClick();
                    this.score = 0;
                    this.combo = 0;
                    this.startRoom(1);
                });

                document.getElementById('btn-sound').addEventListener('click', () => {
                    this.audio.soundEnabled = !this.audio.soundEnabled;
                    document.getElementById('btn-sound').textContent = this.audio.soundEnabled ? '🔊' : '🔇';
                });
            }

            /* ======================================================================
               Game Flow & State Machine
               ====================================================================== */
            showScreen(screenName) {
                Object.values(this.screens).forEach(el => el.classList.add('hidden'));
                if (screenName === 'start') this.screens.start.classList.remove('hidden');
                if (screenName === 'tutorial') this.screens.tutorial.classList.remove('hidden');
                if (screenName === 'roomComplete') this.screens.roomComplete.classList.remove('hidden');
                if (screenName === 'final') this.screens.final.classList.remove('hidden');
            }

            startRoom(roomNum) {
                this.currentRoom = roomNum;
                this.wisdom = 0;
                this.answeredCount = 0;
                this.activePlate = null;
                this.door.reset();
                this.updateHUD();

                // Filter 5 questions for the current room
                const roomQuestions = QUESTIONS_DATA.filter(q => q.room === roomNum);
                this.plates = roomQuestions.map((q, idx) => new StonePlate(idx, idx, roomQuestions.length, q));
                this.plates.forEach(p => p.layout(window.innerWidth, window.innerHeight));

                // Show Room Intro Banner
                this.state = GAME_STATES.ROOM_INTRO;
                this.showScreen(null);

                const introBanner = this.screens.roomIntro;
                document.getElementById('room-intro-title').textContent = `ห้องลับโบราณที่ ${roomNum}`;
                introBanner.classList.remove('hidden');

                this.particles.createBurst(window.innerWidth / 2, window.innerHeight / 2, 40, 'rgba(56, 189, 248,');

                setTimeout(() => {
                    introBanner.classList.add('hidden');
                    this.state = GAME_STATES.PLAYING;
                }, 2200);
            }

            handlePinchClick(x, y) {
                if (this.state === GAME_STATES.PLAYING) {
                    for (let plate of this.plates) {
                        if (plate.contains(x, y) && !plate.isSolved) {
                            this.audio.playClick();
                            this.openQuestion(plate);
                            return;
                        }
                    }
                }
            }

            handleOpenPalm() {
                if (this.state === GAME_STATES.CHOOSING && this.screens.questionModal.classList.contains('hidden') === false) {
                    // Only allow dismiss if answer has been correctly resolved
                    const closeBtn = document.getElementById('btn-modal-close');
                    if (!closeBtn.classList.contains('hidden')) {
                        this.closeQuestionModal();
                    }
                }
            }

            openQuestion(plate) {
                this.activePlate = plate;
                this.state = GAME_STATES.CHOOSING;

                const modal = this.screens.questionModal;
                const container = document.getElementById('ancient-letter-container');
                const choiceContainer = document.getElementById('choice-container');
                const feedbackPanel = document.getElementById('feedback-panel');
                const closeBtn = document.getElementById('btn-modal-close');

                // Set SVG and clear feedback
                container.innerHTML = plate.questionData.ancientSvg;
                feedbackPanel.classList.add('hidden');
                closeBtn.classList.add('hidden');

                // Shuffle Choices
                const choices = [...plate.questionData.choices].sort(() => Math.random() - 0.5);
                choiceContainer.innerHTML = '';

                choices.forEach(ch => {
                    const btn = document.createElement('button');
                    btn.className = "bg-stone-800 hover:bg-amber-600/80 border border-amber-500/40 text-amber-200 font-extrabold text-2xl py-3 rounded-xl transition-all shadow-md active:scale-95";
                    btn.textContent = ch;
                    btn.addEventListener('click', () => this.handleAnswer(ch, btn));
                    choiceContainer.appendChild(btn);
                });

                modal.classList.remove('hidden');
            }

            handleAnswer(selectedLetter, buttonElement) {
                if (!this.activePlate || this.state !== GAME_STATES.CHOOSING) return;

                const q = this.activePlate.questionData;
                const feedbackPanel = document.getElementById('feedback-panel');
                const feedbackTitle = document.getElementById('feedback-title');
                const feedbackFact = document.getElementById('feedback-fact');
                const closeBtn = document.getElementById('btn-modal-close');

                if (selectedLetter === q.modern) {
                    // CORRECT
                    this.audio.playCorrect();
                    this.score += 5;
                    this.wisdom += 1;
                    this.combo += 1;
                    if (this.combo > this.maxCombo) this.maxCombo = this.combo;

                    // Bonus for 3 combo
                    if (this.combo % 3 === 0) {
                        this.score += 5;
                    }

                    this.activePlate.isSolved = true;
                    this.answeredCount += 1;

                    buttonElement.className = "bg-green-600 border border-green-300 text-white font-extrabold text-2xl py-3 rounded-xl";
                    feedbackPanel.className = "mt-3 p-3 rounded-xl border border-green-500/40 bg-green-950/60 text-xs thai-serif";
                    feedbackTitle.innerHTML = `<span class="text-green-400">✅ ถูกต้อง! +5 คะแนน +1 พลังปัญญา</span>`;
                    feedbackFact.textContent = `🏺 เกร็ดความรู้: ${q.fact}`;
                    feedbackPanel.classList.remove('hidden');
                    closeBtn.classList.remove('hidden');

                    this.particles.createBurst(this.cursor.x, this.cursor.y, 35, 'rgba(74, 222, 128,');
                    this.updateHUD();

                    // Check if Room Wisdom is Complete (5/5)
                    if (this.wisdom >= 5) {
                        setTimeout(() => {
                            this.closeQuestionModal();
                            this.unlockDoorSequence();
                        }, 1600);
                    }
                } else {
                    // WRONG
                    this.audio.playWrong();
                    this.combo = 0;
                    this.updateHUD();

                    buttonElement.className = "bg-red-800/80 border border-red-500 text-white font-extrabold text-2xl py-3 rounded-xl";
                    feedbackPanel.className = "mt-3 p-3 rounded-xl border border-red-500/40 bg-red-950/60 text-xs thai-serif";
                    feedbackTitle.innerHTML = `<span class="text-red-400">❌ ยังไม่ถูกต้อง ลองพิจารณาอีกครั้ง</span>`;
                    feedbackFact.textContent = `💡 คำแนะนำ: ${q.hint}`;
                    feedbackPanel.classList.remove('hidden');

                    document.getElementById('game-container').classList.add('shake');
                    setTimeout(() => document.getElementById('game-container').classList.remove('shake'), 500);
                }
            }

            triggerHint() {
                if (this.score >= 3 && this.activePlate) {
                    this.score = Math.max(0, this.score - 3);
                    this.updateHUD();
                    const feedbackPanel = document.getElementById('feedback-panel');
                    const feedbackTitle = document.getElementById('feedback-title');
                    const feedbackFact = document.getElementById('feedback-fact');
                    
                    feedbackPanel.className = "mt-3 p-3 rounded-xl border border-amber-500/40 bg-amber-950/60 text-xs thai-serif";
                    feedbackTitle.innerHTML = `<span class="text-amber-300">💡 คำใบ้พิเศษ (-3 คะแนน)</span>`;
                    feedbackFact.textContent = this.activePlate.questionData.hint;
                    feedbackPanel.classList.remove('hidden');
                }
            }

            closeQuestionModal() {
                this.screens.questionModal.classList.add('hidden');
                this.state = GAME_STATES.PLAYING;
                this.activePlate = null;
            }

            unlockDoorSequence() {
                this.state = GAME_STATES.DOOR_UNLOCK;
                this.audio.playDoorOpen();
                this.door.triggerOpen();
                this.particles.createBurst(window.innerWidth / 2, window.innerHeight * 0.5, 60, 'rgba(56, 189, 248,');

                setTimeout(() => {
                    this.state = GAME_STATES.ROOM_COMPLETE;
                    document.getElementById('rc-score').textContent = this.score;
                    document.getElementById('rc-wisdom').textContent = `${this.wisdom}/5`;
                    document.getElementById('rc-combo').textContent = `x${this.maxCombo}`;
                    this.showScreen('roomComplete');
                }, 2000);
            }

            showFinalTreasure() {
                this.state = GAME_STATES.FINAL_TREASURE;
                this.audio.playVictory();
                this.showScreen('final');

                document.getElementById('final-score').textContent = this.score;
                this.particles.createBurst(window.innerWidth / 2, window.innerHeight / 2, 80, 'rgba(251, 191, 36,');

                // Determine Rank
                let rank = "นักโบราณคดีฝึกหัด";
                let stars = "⭐⭐";
                if (this.score >= 120) {
                    rank = "ปรมาจารย์ศิลาจารึกสุโขทัย 👑";
                    stars = "⭐⭐⭐";
                } else if (this.score >= 80) {
                    rank = "ผู้เชี่ยวชาญลายสือไทย 📜";
                    stars = "⭐⭐⭐";
                }
                document.getElementById('final-rank').textContent = rank;
                document.getElementById('final-stars').innerHTML = stars.split('').map(s => `<span>${s}</span>`).join('');
            }

            updateHUD() {
                this.hud.room.textContent = `🚪 ห้อง ${this.currentRoom}/${this.totalRooms}`;
                this.hud.score.textContent = this.score;
                this.hud.wisdom.textContent = `${this.wisdom}/5`;
                this.hud.wisdomBar.style.width = `${(this.wisdom / 5) * 100}%`;

                if (this.combo > 1) {
                    this.hud.comboBox.classList.remove('hidden');
                    this.hud.combo.textContent = `x${this.combo}`;
                } else {
                    this.hud.comboBox.classList.add('hidden');
                }
            }

            /* ======================================================================
               Main Animation Loop & Rendering Pipeline
               ====================================================================== */
            gameLoop(timestamp) {
                const screenW = window.innerWidth;
                const screenH = window.innerHeight;

                // Update Phase
                this.cursor.update();
                this.particles.update(screenW, screenH);
                this.door.update();

                // Plate Hover Check
                if (this.state === GAME_STATES.PLAYING) {
                    let hoveredAny = false;
                    for (let plate of this.plates) {
                        const isHover = plate.contains(this.cursor.x, this.cursor.y);
                        if (isHover && !plate.isHovered && !plate.isSolved) {
                            this.audio.playHover();
                        }
                        plate.isHovered = isHover;
                        plate.update(timestamp);
                        if (isHover) hoveredAny = true;
                    }
                }

                // Render Phase
                this.ctx.clearRect(0, 0, screenW, screenH);

                // 1. Draw Ancient Room Environment
                this.drawBackground(screenW, screenH);

                // 2. Draw Central Stone Door
                this.door.draw(this.ctx, screenW, screenH, this.currentRoom);

                // 3. Draw Stone Tablets
                if (this.state === GAME_STATES.PLAYING || this.state === GAME_STATES.DOOR_UNLOCK || this.state === GAME_STATES.CHOOSING) {
                    for (let plate of this.plates) {
                        plate.draw(this.ctx);
                    }
                }

                // 4. Draw Hand Skeleton (AR Overlay)
                if (this.handLandmarks) {
                    this.drawHandSkeleton(this.ctx, screenW, screenH);
                }

                // 5. Draw Particles
                this.particles.draw(this.ctx);

                // 6. Draw Glow Cursor
                this.cursor.draw(this.ctx);

                requestAnimationFrame((t) => this.gameLoop(t));
            }

            drawBackground(w, h) {
                // Mystical Sukhothai Cave Gradient
                const bgGradient = this.ctx.createRadialGradient(w / 2, h * 0.5, 50, w / 2, h * 0.5, Math.max(w, h));
                bgGradient.addColorStop(0, '#1c1917');
                bgGradient.addColorStop(0.5, '#0c0a09');
                bgGradient.addColorStop(1, '#020617');
                this.ctx.fillStyle = bgGradient;
                this.ctx.fillRect(0, 0, w, h);

                // Torch Light Ambient Glow
                this.ctx.fillStyle = 'rgba(217, 119, 6, 0.04)';
                this.ctx.beginPath();
                this.ctx.arc(w * 0.2, h * 0.3, 140, 0, Math.PI * 2);
                this.ctx.arc(w * 0.8, h * 0.3, 140, 0, Math.PI * 2);
                this.ctx.fill();
            }

            drawHandSkeleton(ctx, w, h) {
                ctx.save();
                ctx.strokeStyle = 'rgba(56, 189, 248, 0.4)';
                ctx.fillStyle = '#38bdf8';
                ctx.lineWidth = 2;

                const connections = [
                    [0,1],[1,2],[2,3],[3,4],
                    [0,5],[5,6],[6,7],[7,8],
                    [5,9],[9,10],[10,11],[11,12],
                    [9,13],[13,14],[14,15],[15,16],
                    [13,17],[17,18],[18,19],[19,20],[0,17]
                ];

                // Draw Bones
                for (let [start, end] of connections) {
                    const p1 = this.handLandmarks[start];
                    const p2 = this.handLandmarks[end];
                    ctx.beginPath();
                    ctx.moveTo((1 - p1.x) * w, p1.y * h);
                    ctx.lineTo((1 - p2.x) * w, p2.y * h);
                    ctx.stroke();
                }

                // Draw Joints
                for (let lm of this.handLandmarks) {
                    ctx.beginPath();
                    ctx.arc((1 - lm.x) * w, lm.y * h, 3, 0, Math.PI * 2);
                    ctx.fill();
                }
                ctx.restore();
            }
        }

        // Initialize Game Instance on Page Load
        window.addEventListener('DOMContentLoaded', () => {
            window.game = new SukhothaiARGame();
        });
    </script>
