    <style>
        * {
            user-select: none;
            -webkit-user-select: none;
            box-sizing: border-box;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: #0d1117;
            font-family: 'Mitr', 'Sarabun', sans-serif;
        }
        .font-game {
            font-family: 'Chakra Petch', sans-serif;
        }
        /* Camera Feed Mirror */
        #cameraVideo {
            transform: scaleX(-1);
            object-fit: cover;
        }
        /* Glassmorphism Classes */
        .glass-panel {
            background: rgba(18, 24, 38, 0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(234, 179, 8, 0.35);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
        }
        .glass-gold {
            background: linear-gradient(135deg, rgba(234, 179, 8, 0.3) 0%, rgba(161, 98, 7, 0.4) 100%);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(250, 204, 21, 0.7);
            box-shadow: 0 0 25px rgba(234, 179, 8, 0.45);
        }
        /* Animations */
        @keyframes pulseGlow {
            0%, 100% { filter: drop-shadow(0 0 10px rgba(250, 204, 21, 0.6)); }
            50% { filter: drop-shadow(0 0 25px rgba(250, 204, 21, 0.9)); }
        }
        .glow-pulse {
            animation: pulseGlow 2.5s infinite ease-in-out;
        }
        @keyframes floatAnim {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        .float-box {
            animation: floatAnim 3s infinite ease-in-out;
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }
        .animate-shake {
            animation: shake 0.4s ease-in-out;
        }
    </style>
</head>
<body class="relative w-full h-full text-amber-100 overflow-hidden select-none">

